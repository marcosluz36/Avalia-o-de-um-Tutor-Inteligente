# Edite a cópia .env localmente. Nunca compartilhe sua chave.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Caminho opcional. Por padrão, usa data/ ao lado de app.py.
# TUTORIA_DATA_DIR=/caminho/absoluto/tutoria_data
TUTORIA_CHUNK_TOKENS=480
TUTORIA_EMBED_BATCH_SIZE=16
# main é resolvido a um commit imutável na primeira execução da base.
TUTORIA_EMBED_REVISION=main
TUTORIA_OCR=false
TUTORIA_FORMULAS=false
